Content-Type: application/json

{
  "cif": "2026-0001",
  "nombre": "Ana Martinez",
  "periodoAdmisionId": 1,
  "estadoEvaluacion": "PENDIENTE",
  "email": "ana.martinez@correo.com",
  "fechaNacimiento": "2005-04-18"
}

